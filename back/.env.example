DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Futsi usa Supabase/Postgres tambien en local. SQLite queda deshabilitado por default.
# Recomendado: variables separadas para evitar errores si el password contiene caracteres especiales.
DB_ENGINE=postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres.uqvjilgskrqehkdpkhvq
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_HOST=aws-1-us-west-2.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=true

# Alternativa: connection string de Supabase Dashboard > Project Settings > Database.
# No configures SUPABASE_DATABASE_URL si usas POSTGRES_*.
# SUPABASE_DATABASE_URL=postgresql://postgres.uqvjilgskrqehkdpkhvq:YOUR_URL_ENCODED_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Solo para tests/demo aislada, no para desarrollo normal:
# DB_ENGINE=sqlite
# ALLOW_SQLITE=true

# Agente telefonico (solo backend). Usa credenciales nuevas en tu gestor de secretos;
# nunca copies estas variables a front/.env ni uses prefijos VITE_.
OPENAI_API_KEY=REPLACE_WITH_NEW_SERVER_SIDE_KEY
OPENAI_WHATSAPP_MODEL=gpt-5.6-luna
OPENAI_WHATSAPP_FAQ_ENABLED=true
OPENAI_WHATSAPP_TIMEOUT_SECONDS=20

# Opcional: delega plantillas salientes al servicio independiente de WhatsApp.
WHATSAPP_SERVICE_URL=
WHATSAPP_SERVICE_TOKEN=
WHATSAPP_SERVICE_TIMEOUT_SECONDS=20
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_VOICE=cedar
OPENAI_REALTIME_VAD_THRESHOLD=0.75
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=400
OPENAI_REALTIME_VAD_SILENCE_DURATION_MS=700
TWILIO_ACCOUNT_SID=REPLACE_WITH_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_NEW_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+10000000000
# Integración anterior de WhatsApp por Twilio (opcional/legada). Las llamadas
# continúan usando las variables TWILIO_* de arriba.
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_WHATSAPP_INTERACTIVE=true

# WhatsApp Cloud API directa de Meta (independiente de las llamadas de Twilio).
# El VERIFY_TOKEN lo eliges tú; usa una cadena aleatoria y copia exactamente el
# mismo valor al configurar el webhook en Meta.
META_WHATSAPP_PROVIDER=meta
META_WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_META_SYSTEM_USER_TOKEN
META_WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_NUMBER_ID
META_WHATSAPP_DISPLAY_NUMBER=+10000000000
META_WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_RANDOM_VERIFY_TOKEN
META_WHATSAPP_APP_SECRET=REPLACE_WITH_META_APP_SECRET
META_WHATSAPP_GRAPH_VERSION=v23.0
# Para conexiones administradas por Dualhook usa META_WHATSAPP_PROVIDER=dualhook,
# conserva META_WHATSAPP_PHONE_NUMBER_ID/VERIFY_TOKEN y configura estos valores.
# META_WHATSAPP_APP_SECRET no se usa en ese modo porque Dualhook no puede exponerlo.
DUALHOOK_API_KEY=
DUALHOOK_WABA_ID=
DUALHOOK_API_BASE_URL=https://api.dualhook.com
META_WHATSAPP_INTERACTIVE=true
META_WHATSAPP_VALIDATE_SIGNATURES=true
META_WHATSAPP_PAYMENT_TEMPLATE=futsi_recordatorio_pago
META_WHATSAPP_TEMPLATE_LANGUAGE=es_MX
META_WHATSAPP_DEFAULT_SITE_CODE=cuajimalpa
META_WHATSAPP_LOCATION_NAME=B Power Academy · UVM Lomas Verdes
META_WHATSAPP_LOCATION_ADDRESS=Paseo de las Aves 1, San Mateo Nopala, Naucalpan de Juárez, Estado de México, C.P. 53220
META_WHATSAPP_CONTACT_PHONE=+52 55 7485 8165
META_WHATSAPP_LOCATION_LATITUDE=19.507465
META_WHATSAPP_LOCATION_LONGITUDE=-99.262555
TWILIO_PUBLIC_BASE_URL=https://your-api.example.com
TWILIO_STREAM_URL=wss://your-api.example.com/ws/voice/twilio/
TWILIO_VALIDATE_SIGNATURES=true
TRIAL_MIN_ADVANCE_HOURS=2
TRIAL_BOOKING_HORIZON_DAYS=30
TRIAL_MIN_DAYS_BETWEEN_VISITS=1
TRIAL_MAX_DAYS_BETWEEN_VISITS=21
VOICE_MAX_CALL_SECONDS=900
VOICE_IDLE_TIMEOUT_SECONDS=90
VOICE_CALLS_PER_NUMBER_PER_HOUR=5
VOICE_MAX_CONCURRENT_STREAMS=5
VOICE_TRANSCRIPT_RETENTION_DAYS=90
VOICE_CALL_RETENTION_DAYS=365
TRIAL_PII_RETENTION_DAYS=365
VOICE_RETENTION_BATCH_SIZE=1000

# Pase automatico local: por default borra el video descargado/subido al terminar.
# Activa esto solo para depurar errores y conservar videos fallidos en media/automatic_attendance/errores.
AUTO_ATTENDANCE_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
AUTO_ATTENDANCE_EVIDENCE_BUCKET=automatic-attendance-evidence
AUTO_ATTENDANCE_KEEP_FAILED_VIDEO=false
AUTO_ATTENDANCE_PROBE_WINDOW_SECONDS=4
AUTO_ATTENDANCE_DENSE_FRAME_STRIDE=8
AUTO_ATTENDANCE_MIN_WINDOW_COVERAGE_RATIO=0.80
AUTO_ATTENDANCE_VIDEO_CLUSTER_SIMILARITY=0.52
AUTO_ATTENDANCE_CLUSTER_TOP_FACES=3
AUTO_ATTENDANCE_MAX_FACE_GROUPS=80
AUTO_ATTENDANCE_MIN_DET_SCORE=0.45
AUTO_ATTENDANCE_MIN_FACE_SIZE=24
AUTO_ATTENDANCE_MIN_BLUR=5
UNKNOWN_ATTENDANCE_FACE_BUCKET=unknown-attendance-faces
UNKNOWN_ATTENDANCE_MIN_DET_SCORE=0.80
UNKNOWN_ATTENDANCE_MIN_FACE_SIZE=120
UNKNOWN_ATTENDANCE_MIN_BLUR=80
UNKNOWN_ATTENDANCE_MAX_CENTER_WHITE_RATIO=0.085
UNKNOWN_ATTENDANCE_MIN_MEAN_LUMA=70
UNKNOWN_ATTENDANCE_MIN_MEDIAN_LUMA=60
UNKNOWN_ATTENDANCE_MAX_DARK_RATIO=0.60
UNKNOWN_ATTENDANCE_KNOWN_THRESHOLD=0.35
UNKNOWN_ATTENDANCE_DUPLICATE_THRESHOLD=0.55
UNKNOWN_ATTENDANCE_DOWNLOAD_WORKERS=8
UNKNOWN_ATTENDANCE_KEEP_DOWNLOADED=false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
