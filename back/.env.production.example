DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DJANGO_ALLOWED_HOSTS=api.example.com,futsi-api.onrender.com
CORS_ALLOWED_ORIGINS=https://example.github.io
CSRF_TRUSTED_ORIGINS=https://example.github.io

# Recomendado en Render: variables separadas para evitar errores de URL encoding.
# No configures SUPABASE_DATABASE_URL si usas estas variables.
DB_ENGINE=postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres.uqvjilgskrqehkdpkhvq
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_HOST=aws-1-us-west-2.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
RUN_SEED_DEMO=true

# Agente telefonico: todos los secretos se configuran directamente en Render.
OPENAI_API_KEY=REPLACE_WITH_NEW_SERVER_SIDE_KEY
OPENAI_WHATSAPP_MODEL=gpt-5.6-luna
OPENAI_WHATSAPP_FAQ_ENABLED=true
OPENAI_WHATSAPP_TIMEOUT_SECONDS=20

# URL del nuevo servicio siempre activo y secreto compartido entre servidores.
WHATSAPP_SERVICE_URL=https://futsi-whatsapp.onrender.com
WHATSAPP_SERVICE_TOKEN=REPLACE_WITH_SHARED_SERVICE_TOKEN
WHATSAPP_SERVICE_TIMEOUT_SECONDS=20
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_VOICE=cedar
OPENAI_REALTIME_VAD_THRESHOLD=0.75
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=400
OPENAI_REALTIME_VAD_SILENCE_DURATION_MS=700
TWILIO_ACCOUNT_SID=REPLACE_WITH_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_NEW_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+10000000000
# WhatsApp por Twilio queda como integración legada/opcional.
TWILIO_WHATSAPP_NUMBER=+10000000000
TWILIO_WHATSAPP_INTERACTIVE=true

# WhatsApp Cloud API directa de Meta. Configura todos los secretos en Render,
# nunca en el frontend ni dentro del repositorio.
META_WHATSAPP_PROVIDER=meta
META_WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_META_SYSTEM_USER_TOKEN
META_WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_NUMBER_ID
META_WHATSAPP_DISPLAY_NUMBER=+10000000000
META_WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_RANDOM_VERIFY_TOKEN
META_WHATSAPP_APP_SECRET=REPLACE_WITH_META_APP_SECRET
META_WHATSAPP_GRAPH_VERSION=v23.0
DUALHOOK_API_KEY=
DUALHOOK_WABA_ID=
DUALHOOK_API_BASE_URL=https://api.dualhook.com
META_WHATSAPP_INTERACTIVE=true
META_WHATSAPP_VALIDATE_SIGNATURES=true
META_WHATSAPP_PAYMENT_TEMPLATE=futsi_recordatorio_pago
META_WHATSAPP_TEMPLATE_LANGUAGE=es_MX
META_WHATSAPP_DEFAULT_SITE_CODE=cuajimalpa
META_WHATSAPP_LOCATION_NAME=Power Soccer Academy
META_WHATSAPP_LOCATION_ADDRESS=Antiguo Camino a Tecamachalco 686, Lomas de Vista Hermosa, Cuajimalpa de Morelos, 05100 Ciudad de México
META_WHATSAPP_CONTACT_PHONE=+52 55 7895 0758
META_WHATSAPP_LOCATION_LATITUDE=19.3824617
META_WHATSAPP_LOCATION_LONGITUDE=-99.2780863
TWILIO_PUBLIC_BASE_URL=https://your-api.example.com
TWILIO_STREAM_URL=wss://your-api.example.com/ws/voice/twilio/
TWILIO_VALIDATE_SIGNATURES=true
TRIAL_MIN_ADVANCE_HOURS=2
TRIAL_BOOKING_HORIZON_DAYS=30
TRIAL_MIN_DAYS_BETWEEN_VISITS=1
TRIAL_MAX_DAYS_BETWEEN_VISITS=21
VOICE_MAX_CALL_SECONDS=900
VOICE_IDLE_TIMEOUT_SECONDS=90
VOICE_CALLS_PER_NUMBER_PER_HOUR=5
VOICE_MAX_CONCURRENT_STREAMS=5
VOICE_TRANSCRIPT_RETENTION_DAYS=90
